{
  "name": "sigstore-playground",
  "version": "1.0.0",
  "description": "An interactive visual playground to learn how Sigstore works",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --check src",
    "format:fix": "prettier --write src",
    "test": "vitest",
    "coverage": "vitest run --coverage --passWithNoTests",
    "prepare": "husky",
    "sbom": "npm sbom --sbom-format=cyclonedx --sbom-type=application > sbom.json",
    "sbom:check": "npm run sbom && echo 'SBOM generated successfully'"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ]
  },
  "keywords": [
    "sigstore",
    "security",
    "signing",
    "solidjs",
    "interactive"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "motion": "^12.33.0",
    "solid-js": "^1.9.3",
    "solid-motionone": "^1.0.3"
  },
  "devDependencies": {
    "@codecov/vite-plugin": "^1.9.1",
    "@eslint/js": "^9.39.2",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^4.0.18"
  }
}
